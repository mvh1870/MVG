# Governance Kompass – Webserver-Regeln für IONOS (Apache). Wird von werkzeuge/bau.mjs als dist/.htaccess kopiert.
# Nur Regeln, die IONOS-Webspace unterstützt; jede steht in einem IfModule, damit ein fehlendes Modul keinen Fehler 500 auslöst.

# Immer HTTPS und immer mit www (eine Adresse, keine Doppelinhalte)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.governancekompass.de%{REQUEST_URI} [L,R=301]
</IfModule>

DirectoryIndex index.html
Options -Indexes

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  # Die Seite darf nicht in fremde Rahmen eingebettet werden (frame-ancestors wirkt nur als Kopf)
  Header always set Content-Security-Policy "frame-ancestors 'none'"
  Header always set X-Frame-Options "DENY"
</IfModule>

<IfModule mod_mime.c>
  AddType text/html .html
  AddType application/xml .xml
  AddCharset utf-8 .html .txt .xml
</IfModule>

# Kurze Zwischenspeicherung: ein neuer Upload ist nach spätestens einer Stunde überall sichtbar
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType image/png "access plus 1 week"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain application/xml
</IfModule>
