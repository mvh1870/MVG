{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] || exit 0; python3 \"$CLAUDE_PROJECT_DIR/cloud/fortsetzer.py\" --haken",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] || exit 0; python3 \"$CLAUDE_PROJECT_DIR/cloud/dialog-sperre.py\"",
            "timeout": 20
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_STOP_HOOK_BLOCK_CAP": "30"
  }
}
